# Upstream service that actually serves the model (your key reseller).
UPSTREAM_BASE_URL=https://api.freeaiapikey.com/v1

# Your key for that service. Never commit this file.
UPSTREAM_API_KEY=

# Bare model ids registered in QM get this prefix before being forwarded,
# because the upstream only answers to its fully qualified names.
UPSTREAM_MODEL_PREFIX=anthropic/

# Port the shim listens on. QM containers reach the host via host.docker.internal.
PORT=8090

# Optional per-model overrides, e.g. {"gpt-5.6":"openai/gpt-6-sol"}
MODEL_MAP={}
